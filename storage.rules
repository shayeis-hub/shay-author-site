rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'shayeis@gmail.com';
    }
    match /dashboard-photos/{path=**} {
      allow get: if resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && resource.size <= 5 * 1024 * 1024;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if isAdmin();
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
